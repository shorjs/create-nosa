{
  "name": "create-nosa",
  "version": "0.0.5",
  "description": "Create a new nosa project",
  "keywords": [
    "bun",
    "create",
    "nosa",
    "scaffold"
  ],
  "homepage": "https://github.com/shorjs/create-nosa#readme",
  "bugs": {
    "url": "https://github.com/shorjs/create-nosa/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shorjs/create-nosa.git"
  },
  "bin": {
    "create-nosa": "./index.ts"
  },
  "files": [
    "index.ts",
    "src",
    "templates"
  ],
  "type": "module",
  "scripts": {
    "lint": "oxlint --disable-nested-config",
    "lint:fix": "oxlint --fix --disable-nested-config",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "release": "bumpp --git-check --commit --push --tag",
    "ts:check": "tsc --noEmit",
    "prepare": "bun run simple-git-hooks"
  },
  "dependencies": {
    "@clack/prompts": "^1.4.0",
    "citty": "^0.2.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "bumpp": "^11.1.0",
    "nano-staged": "^1.0.2",
    "oxfmt": "^0.49.0",
    "oxlint": "^1.64.0",
    "oxlint-tsgolint": "^0.22.1",
    "simple-git-hooks": "^2.13.1",
    "typescript": "^5"
  },
  "simple-git-hooks": {
    "pre-commit": "./node_modules/.bin/nano-staged"
  },
  "nano-staged": {
    "*": "bun run fmt --no-error-on-unmatched-pattern",
    "*.{js,jsx,ts,tsx,mjs,cjs}": "bun run lint:fix"
  },
  "engines": {
    "bun": ">=1.3.0"
  }
}
