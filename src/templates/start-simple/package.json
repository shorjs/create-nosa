{
  "name": "start-simple",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "postinstall": "bunx --bun simple-git-hooks"
  },
  "dependencies": {
    "@tailwindcss/vite": "4.3.0",
    "@tanstack/react-router": "1.170.4",
    "@tanstack/react-start": "1.168.6",
    "oxlint-tsgolint": "0.23.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "tailwindcss": "4.3.0"
  },
  "devDependencies": {
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "nano-staged": "1.0.2",
    "oxfmt": "0.50.0",
    "oxlint": "1.65.0",
    "simple-git-hooks": "2.13.1",
    "typescript": "6.0.3",
    "vite": "8.0.13"
  },
  "simple-git-hooks": {
    "pre-commit": "./node_modules/.bin/nano-staged"
  },
  "nano-staged": {
    "*": "bun run fmt --no-error-on-unmatched-pattern",
    "*.{js,jsx,ts,tsx,mjs,cjs}": "bun run lint:fix"
  }
}
